{
  "compilerOptions": {
    "target": "ES2022",
    "module": "commonjs",
    "lib": ["ES2022"],
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "resolveJsonModule": true,
    "outDir": "./dist",
    "rootDir": ".",
    "paths": {
      "@kernel/*": ["./kernel/*"]
    }
  },
  "include": ["kernel/**/*.ts", "server.ts"],
  "exclude": ["node_modules", "dist", ".next"]
}
